{
	"name": "research-connected",
	"version": "1.6.0",
	"description": "Research Connected: a similarity map inside Obsidian, powered by OpenAlex, with a 3D note embed.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"verify": "node esbuild.config.mjs verify && node scripts/verify.cjs",
		"test": "node esbuild.config.mjs verify && node scripts/verify.cjs --offline",
		"preview": "node esbuild.config.mjs preview",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.15.17",
		"@types/three": "^0.170.0",
		"esbuild": "0.25.5",
		"obsidian": "1.13.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"three": "^0.170.0"
	}
}
