# Root-only on the VPS, mode 0600. Copy to /etc/research-connected-web.env
# Do not put real keys in Git, bundles, chat, or browser storage.

OPENALEX_API_KEY=
OPENALEX_CONTACT_EMAIL=
OPENALEX_DAILY_BUDGET_USD=1
# Only an offline-test fallback; production reads authoritative endpoint costs.
OPENALEX_REQUEST_COST_USD=0.0001
OPENALEX_ALLOW_LOCAL=0
OPENALEX_ALLOW_LOCAL_ORIGINS=false
OPENALEX_ALLOW_MOCK=0
LISTEN_HOST=127.0.0.1
LISTEN_PORT=9186
QUOTA_STATE_PATH=/var/lib/research-connected/quota-state.json
# Comma-separated IPs/CIDRs allowed to supply CF-Connecting-IP / X-Forwarded-For.
# Leave empty on loopback-only deploys so peer IP is always used.
TRUSTED_PROXIES=127.0.0.1
WEB_VERSION_PATH=/var/www/graph.jieyu.ai/version.json
